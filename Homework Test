from turtle import speed
import pygame

# Initialize pygame
pygame.init()

# Set display surface
WINDOW_WIDTH = 800
WINDOW_HEIGHT = 600
display_surface = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT))
pygame.display.set_caption("Paddle Game")

#load the sound and play it when required
effect=pygame.mixer.Sound("Nanocillium Game\Test Materials/boiler plate_game_over.mp3")
sound=pygame.mixer.Sound("Nanocillium Game\Test Materials/boiler plate_hit.mp3")

# Set FPS and clock
FPS = 60
clock = pygame.time.Clock()
font = pygame.font.Font(None, 36)  # Default font, size 36
# Colors
WHITE = (255, 255, 255)

class PlayerPaddle1(pygame.sprite.Sprite):
    def __init__(self, x, y, is_player=True):
        super().__init__()
        self.image = pygame.Surface((20, 100))
        self.image.fill(WHITE)
        self.rect = self.image.get_rect()
        self.rect.center = (x, y)
        self.velocity = 8
        self.score= 0
    
    def update(self):
        #write the code for player 1 to move
        keys = pygame.key.get_pressed()
        if keys[pygame.K_w]:
            self.rect.y -= self.velocity
        if keys [pygame.K_s]:
            self.rect.y +=self.velocity

class PlayerPaddle2(pygame.sprite.Sprite):
    def __init__(self, x, y, is_player=True):
        super().__init__()
        self.image = pygame.Surface((20, 100))
        self.image.fill(WHITE)
        self.rect = self.image.get_rect()
        self.rect.center = (x, y)
        self.velocity = 8
        self.score=0
    
    def update(self):
        #write the code for player 2 to move
        if event.type==pygame.KEYDOWN:
            if event.key==pygame.K_UP:
                self.rect.y = self.rect.y - self.velocity
            if event.key==pygame.K_DOWN:
                self.rect.y = self.rect.y + self.velocity

class Ball(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        self.image = pygame.Surface((20, 20))
        self.image.fill(WHITE)
        self.rect = self.image.get_rect()
        self.rect.center = (x, y)
        self.velocity_x = 3
        self.velocity_y = 3
    
    def update(self):
        #write the code for ball movement
        self.rect.x = self.rect.x + self.velocity_x
        self.rect.y = self.rect.y + self.velocity_y
        if self.rect.top <= 0 or self.rect.bottom >= WINDOW_HEIGHT:
            self.velocity_y*= -1
            sound.play()


# Create game objects
player_paddle1 = PlayerPaddle1(30, WINDOW_HEIGHT//2, is_player=True)
player_paddle2 = PlayerPaddle2(WINDOW_WIDTH-50, WINDOW_HEIGHT//2, is_player=False)
ball = Ball(WINDOW_WIDTH//2, WINDOW_HEIGHT//2)

# Create sprite groups
all_sprites = pygame.sprite.Group()
all_sprites.add(player_paddle1, player_paddle2, ball)

# Main game loop
running = True
gameover=False
MAX_SCORE = 2
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
                
    
    # Update objects
    player_paddle1.update()
    player_paddle2.update()
    ball.update()


    player1_score_text = font.render(f"Player 1 Score: {player_paddle1.score}", True, WHITE)
    player1_score_rect = player1_score_text.get_rect(topleft=(10, 10)) 

    player2_score_text = font.render(f"Player 2 Score: {player_paddle2.score}", True, WHITE)
    player2_score_rect = player2_score_text.get_rect(topright=(780, 10)) 

 


    #Write the conditions if the ball goes out of bound
    if ball.rect.x <= 0:
        player_paddle2.score = player_paddle2.score + 1
        ball.rect.x = 400
        ball.rect.y = 300
        ball.velocity_y*= -1
    
    if ball.rect.x >= WINDOW_WIDTH:
        player_paddle1.score = player_paddle1.score + 1
        ball.rect.x = 400
        ball.rect.y = 300
        ball.velocity_y*= -1

    #write gameover condition
    if player_paddle1.score  >= MAX_SCORE:
        gameover_text=font.render(f"Game Over!!!.  Player1 Wins ", True, "red")
        gameover=True
    if player_paddle2.score >= MAX_SCORE:
        gameover_text=font.render(f"Game Over!!!. Player2 Wins", True, "yellow")
        gameover=True
    if gameover:
        gameover_rect = gameover_text.get_rect(center=(WINDOW_WIDTH // 2, WINDOW_HEIGHT // 2))
        display_surface.fill("black")
        display_surface.blit( gameover_text, gameover_rect)
        pygame.display.update()
        pygame.time.delay(3000)
        running=False    
    #Write Ball collision with paddles condition
          #write the code for the bounce off condition
    if pygame.sprite.collide_rect(ball, player_paddle1):
        ball.velocity_x*= -1
        effect.play()
    if pygame.sprite.collide_rect(ball, player_paddle2):
        ball.velocity_x*= -1
        effect.play()
   
    # Draw everything
    display_surface.fill((0,0,0))
    all_sprites.draw(display_surface)

    display_surface.blit(player1_score_text, player1_score_rect)
    display_surface.blit(player2_score_text, player2_score_rect)
    pygame.display.update()
    clock.tick(FPS)
    
pygame.quit()
